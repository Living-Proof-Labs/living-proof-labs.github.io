{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Inherits the shared preset: external updates weekly, internal updates eligible on each hosted run, automerge off. Retains repository-specific dependency managers and disables lockfile maintenance.",
  "extends": [
    "github>Living-Proof-Labs/collaboration-guidelines:renovate-preset#v9.7.0"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pep621",
    "renovate-config",
    "custom.regex"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the organization content release and its resolved commit together.",
      "managerFilePatterns": [
        "/^content\\.lock\\.json$/"
      ],
      "matchStrings": [
        "\"repository\"\\s*:\\s*\"(?<depName>Living-Proof-Labs/\\.github)\"\\s*,\\s*\"tag\"\\s*:\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*,\\s*\"commit\"\\s*:\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
